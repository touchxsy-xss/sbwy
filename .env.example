# Static resident frontend -> Fastify API integration.
# Prefer the same-origin proxy for cookie-based sessions during local development.
SHENGBIAN_API_PROXY_TARGET=http://127.0.0.1:3001

# Alternative cross-origin API base. Leave unset when using the proxy above.
# SHENGBIAN_API_BASE=http://127.0.0.1:3001/api/v1

# Static frontend port.
PORT=5173
